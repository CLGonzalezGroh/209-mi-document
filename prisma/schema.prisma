// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================
// ENUMS DEL MÓDULO DE DOCUMENTOS
// ================================

enum ModuleType {
  QUALITY
  PROJECTS
  TAGS
  OPERATIONS
  MANAGEMENT
  COMERCIAL
}

enum SysLogModule {
  DOCUMENT
  QUALITY
  PROJECTS
  TAGS
  OPERATIONS
  MANAGEMENT
  COMERCIAL
}

// Esquema con que se numera la revisión siguiente (BLOQUE 03, B13).
// NO se persiste en el documento: se elige al crear cada revisión y el sistema
// propone el código. El escalón del documento se lee de su última revisión.
// Alineado con el precedente de digitalización (CatalogRevisionScheme).
enum RevisionScheme {
  ALPHA // A, B, C, ..., Z, AA, AB, ... (generado por el sistema)
  NUMERIC // 0, 1, 2, 3, ... (generado por el sistema)
  FREE_TEXT // Texto libre, lo escribe el usuario
}

// Una palabra por nivel para terminar mal (BLOQUE 03B, B11): el circuito se
// CANCELA, la revisión se ABANDONA y el documento queda OBSOLETO. Cada término
// pertenece a un solo nivel y no se usa en ningún otro.
enum RevisionStatus {
  DRAFT // En elaboración: el circuito está en armado o en elaboración
  IN_REVIEW // Sometida: el circuito avanza por revisión y aprobación
  APPROVED // Aprobada, metadata congelada, no admite versiones nuevas
  SUPERSEDED // Reemplazada por una revisión posterior aprobada
  ABANDONED // Se desistió antes de aprobarla (BLOQUE 03B, B11). No consume código
  REJECTED // La contraparte la rechazó y el circuito concluyó. Solo en RECEIVER
  // OBSOLETE se retiró en BLOQUE 03B: estaba declarado sin uso y reservado a los
  // estados terminales por respuesta de la contraparte.
  //
  // BLOQUE 04 corrige aquella confirmación. `REJECTED` no es el `OBSOLETE` que
  // se retiró —obsoleto es lo que dejó de aplicar— sino lo que en modo Receptor
  // le faltaba a la revisión: en Emisor e Interno el rechazo la devuelve a
  // borrador y abre otro circuito, pero ahí el elaborador está AFUERA y no hay a
  // quién devolverle el trabajo (B12). Sin este estado la revisión quedaba en
  // DRAFT para siempre, bloqueando la emisión siguiente, que es H-01 reapareciendo
  // en el otro modo.
  //
  // Consume código, a diferencia de ABANDONED: esta revisión salió y la
  // contraparte ya la recibió con su código.
}

enum WorkflowStatus {
  IN_PROGRESS // Circuito abierto. Nace así: el circuito se instancia iniciado (B2)
  COMPLETED // Los pasos que deciden se resolvieron favorablemente
  REJECTED // Un paso que decide rechazó
  CANCELLED // Retirado sin juicio, con motivo propio. Exclusivo del circuito
}

// Papel del archivo dentro del conjunto de la versión (BLOQUE 03B, B7).
//
// Enumeración y no catálogo configurable, por el criterio de D-22: es catálogo
// cuando el usuario elige el rótulo, y enumeración cuando el SISTEMA interpreta
// el efecto. Acá lo interpreta —qué se revisa, qué se marca, qué se exige al
// emitir—, de modo que un valor libre no tendría comportamiento asociado.
enum DocFileRole {
  DELIVERABLE // El entregable, típicamente PDF. Se revisa y se marca. Al menos uno
  SOURCE // La fuente editable, típicamente DWG. Acompaña en custodia
  SUPPORT // La evidencia que formó parte de producirlo: memoria de cálculo, ensayos
}

// Papel del documento dentro del acto de reemplazo (BLOQUE 03B, B5).
enum DocReplacementRole {
  REPLACED // Queda obsoleto en el mismo acto
  REPLACING // Lo supera
}

// Pasos del circuito, en el orden en que se recorren (BLOQUE 03, B1).
// Los dos primeros los pone el sistema y no la plantilla; los tres últimos
// son las casillas del rótulo del plano más el acuse.
enum StepType {
  ASSIGN // Armado: designa elaborador y revisores, y materializa los pasos siguientes
  PREPARE // Elaboración: el documento está hecho y se somete a revisión
  REVIEW // Revisión técnica
  APPROVE // Aprobación formal
  ACKNOWLEDGE // Toma de conocimiento
}

enum StepStatus {
  PENDING // No resuelto aún
  COMPLETED // Cumplido, sin emitir juicio: ASSIGN, PREPARE y ACKNOWLEDGE (B8)
  APPROVED // Aprobado por quien resolvió: solo REVIEW y APPROVE
  REJECTED // Rechazado por quien resolvió: solo REVIEW y APPROVE
  SKIPPED // Saltado por rechazo o por cancelación del circuito
}

// Naturaleza del transmittal (BLOQUE 04, B1).
//
// La clasificación relevante NO es la dirección sino el propósito (D-18), que
// determina qué reglas lo gobiernan. El sentido —saliente o entrante— se DERIVA
// del rol del proyecto y de la naturaleza, y no se almacena: un dato guardado
// que puede contradecir a los hechos obliga a inventar una precondición que
// tape la incoherencia, que es el criterio con que D-13 retiró el esquema de
// revisión del documento.
//
// La información de partida NO es una naturaleza: D-20 la trasladó a un objeto
// propio, porque su contenido son archivos sin catalogar y no revisiones. Las
// dos que quedan operan ambas sobre revisiones, con una sola clase de ítem.
enum TransmittalNature {
  EMISSION // Entrega de documentación producida
  RESPONSE // Calificación consolidada de una emisión. Solo en modo Emisor
}

enum TransmittalStatus {
  DRAFT // En preparación
  ISSUED // Enviado al cliente
  ACKNOWLEDGED // Cliente acusó recibo
  RESPONDED // Cliente respondió con comentarios
  CLOSED // Cerrado
}

enum PurposeCode {
  FOR_APPROVAL // Para aprobación del cliente
  FOR_INFORMATION // Solo informativo
  FOR_CONSTRUCTION // Aprobado para construcción
  FOR_REVIEW // Para revisión y comentarios
  AS_BUILT // Documentación as-built
}

enum LogLevel {
  INFO
  WARNING
  ERROR
}

// Rol de un documento respecto a una tarea de proyecto (federación A.5)
enum TaskDocumentRole {
  INPUT // Insumo que la tarea consume (norma, BoD, especificación)
  OUTPUT // Documento producido por la tarea (no entregable principal)
  REFERENCE // Referencia cruzada (documento relacionado, no consumido ni producido)
}

// Rol documental que el proyecto declara (BLOQUE 02, D-09 y D-19).
// Determina el orden entre el circuito de revisión y el transmittal.
enum DocumentRole {
  ISSUER // Emisor: el sistema es de la ingeniería; el circuito precede a la emisión
  RECEIVER // Receptor: el sistema es de la planta; la emisión precede a la calificación
  INTERNAL // Interno: no hay contraparte; el ciclo termina en la aprobación
}

// Lado del proyecto al que pertenece un miembro (BLOQUE 02, D-15).
// El rótulo visible lo aporta el rol del proyecto: Ingeniería/Cliente o Planta/Contratista.
enum DocProjectSide {
  HOST // Organización que hospeda el sistema. Único lado posible en proyectos INTERNAL
  COUNTERPARTY // Cliente en modo Emisor, contratista en modo Receptor
}

// ================================
// MODELOS
// ================================

// Clases de documento (nivel 1: Especialidad, Categoría, etc.)
model DocumentClass {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  updatedById  Int       @default(1)
  terminatedAt DateTime?
  isSys        Boolean   @default(false)

  name        String // "Ingeniería Civil", "Eléctrica", "Gestión"
  code        String // "CIVIL", "ELEC", "GEST"
  module      ModuleType? // null = disponible para todos los módulos
  description String?
  sortOrder   Int         @default(0)

  // Relaciones
  documentTypes     DocumentType[]
  documents         Document[] // Por la COPIA del documento (BLOQUE 03B, B2)
  revisions         DocumentRevision[] // Por el dato, que vive en la revisión (B1)
  scannedFiles      ScannedFile[]
  workflowTemplates DocWorkflowTemplate[]

  // Los dos índices se recrean con NULLS NOT DISTINCT en la migración de
  // BLOQUE 03, B15, porque Prisma no expresa esa cláusula. Se declaran igual
  // acá para conservar la clave compuesta en el cliente y para que la ausencia
  // no se lea como deriva. Cierra H-19 en el catálogo: sin la cláusula, dos
  // entradas sin módulo —el caso más frecuente en un catálogo recién sembrado—
  // no se consideraban duplicadas.
  @@unique([name, module]) // NULLS NOT DISTINCT en la base
  @@unique([code, module]) // NULLS NOT DISTINCT en la base
  @@map("document_classes")
}

// Tipos de documento (Procedimiento, Plano, Informe, etc.)
model DocumentType {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  updatedById  Int       @default(1)
  terminatedAt DateTime?
  isSys        Boolean   @default(false)

  name        String // "Procedimiento", "Plano", "Informe"
  code        String // "PROC", "DWG", "RPT"
  module      ModuleType? // null = disponible para todos los módulos
  classId     Int? // null = disponible para todas las clases
  description String?

  // Distingue el circuito formal del mínimo (BLOQUE 03, B1). Bajo D-03 toda
  // revisión tiene circuito, de modo que ya no indica si lo hay.
  // Es SUGERENCIA y no invariante: propone el armado, no lo impone.
  requiresFormalReview Boolean @default(false)

  // Relaciones
  class             DocumentClass?        @relation(fields: [classId], references: [id])
  documents         Document[] // Por la COPIA del documento (BLOQUE 03B, B2)
  revisions         DocumentRevision[] // Por el dato, que vive en la revisión (B1)
  scannedFiles      ScannedFile[]
  workflowTemplates DocWorkflowTemplate[]

  // Mismo tratamiento que en DocumentClass (B15): los dos índices se recrean
  // con NULLS NOT DISTINCT en la migración. Con classId o module nulos la
  // restricción anterior no impedía el duplicado.
  @@unique([name, classId, module]) // NULLS NOT DISTINCT en la base
  @@unique([code, classId, module]) // NULLS NOT DISTINCT en la base
  @@index([classId])
  @@map("document_types")
}

// Documento maestro
model Document {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  createdById  Int // Referencia al User del sistema admin
  updatedAt    DateTime? @updatedAt
  updatedById  Int       @default(1)
  terminatedAt DateTime?
  isSys        Boolean   @default(false)

  // El código es el IDENTIFICADOR y no cambia (BLOQUE 03B, B3). Está en los
  // transmittals emitidos, en el payload de cada firma, en las referencias
  // cruzadas de otros documentos y en el rótulo de cada archivo que salió:
  // cambiarlo rompe la correspondencia con todo lo que ya lo nombra y que el
  // sistema no controla. Se corrige solo mientras el documento no tenga ninguna
  // revisión aprobada (B4); después, lo que corresponde es un documento nuevo
  // que lo reemplace y lo supere (B5).
  code String

  // La descripción es ADMINISTRATIVA: no se imprime en el rótulo, de modo que
  // se edita siempre y no se congela con la revisión aprobada (B1).
  description String?
  module      ModuleType // Quality, Projects, Tags, etc.

  // Proyecto al que pertenece el documento (BLOQUE 02, D-06).
  // Referencia externa sin FK: Project vive en mi-project.
  // Obligatorio por invariante cuando module = PROJECTS.
  // Nulo NO es una ausencia: identifica el régimen de publicación, documentación
  // que no circula y se gobierna por permiso global y clasificación.
  projectId Int?

  // Metadata de identificación: COPIA de la revisión en curso, no dato propio
  // (BLOQUE 03B, B1 y B2). El dato vive en DocumentRevision, porque está impreso
  // en el rótulo del archivo y por lo tanto pertenece a la emisión que lo
  // produjo. Acá se replica para que listados, filtros e índices no paguen un
  // join, y su ÚNICO ESCRITOR es la transición de la revisión.
  //
  // El prefijo `current` nombra la lectura que sirve: la de la revisión EN CURSO.
  // Un campo desnudo significaría eso mismo sin decirlo, y quien buscara el
  // rótulo aprobado se llevaría otro valor sin enterarse —lo que el §13 previene
  // al pedir que las dos lecturas se expongan y no se deriven en cada consumidor.
  // La metadata VIGENTE se lee de la revisión aprobada, que lleva la suya.
  currentTitle           String
  currentDocumentTypeId  Int
  currentDocumentClassId Int? // Clase de documento (null = sin clasificar)

  // Obsolescencia del documento (BLOQUE 03B, B5). Dos causas llegan al mismo
  // estado: haber sido reemplazado por otro que lo supera, y haber salido del
  // alcance del proyecto sin que nada lo reemplace. Por eso el hecho se REGISTRA
  // acá y no se deriva de la existencia de un reemplazo; lo que sí se deriva es
  // la CAUSA, según el documento figure o no en un acto de reemplazo.
  //
  // Obsoleto NO es dado de baja: `terminatedAt` corrige un alta que no debió
  // existir, y la obsolescencia es un hecho del ciclo de vida —el documento
  // existió, sirvió y dejó de servir— que conserva su historia entera.
  obsoletedAt    DateTime?
  obsoletedById  Int?
  obsoleteReason String?

  // NO hay revisionScheme: el esquema no se persiste (BLOQUE 03, B13). Se elige
  // al crear cada revisión y se infiere de la última revisión no abortada.
  // Un esquema almacenado podía contradecir a los hechos —declarar NUMERIC con
  // la revisión vigente en A— y obligaba a una precondición para taparlo.

  // Ubicación física del documento (BLOQUE 02B, B3 y B5).
  //
  // Pertenece al DOCUMENTO y no a la revisión, y se edita SIEMPRE: no entra en el
  // congelamiento de D-05 ni en el payload de la firma. Que aparezca impresa en
  // el rótulo no la vuelve identificación —lo que D-23 sostiene es que la
  // identificación pertenece a la emisión, no que todo lo impreso lo haga—. El
  // código identifica, el título describe la emisión, y la ubicación CLASIFICA.
  //
  // Un nodo, habitualmente la hoja (B5). El documento que alcanza dos áreas
  // apunta al ancestro común, que un árbol de profundidad libre ya permite.
  //
  // `locationPath` es el snapshot de la ruta, y es DENORMALIZACIÓN de conveniencia
  // y no evidencia (B6): evita el join en cada listado, y renombrar o mover un
  // nodo lo recalcula de forma automática. Su único escritor es la operación de
  // la ubicación, más el alta y la edición del documento.
  //
  // Opcional en los tres roles (B4). La obligatoriedad se configura por proyecto
  // y no es del modelo, con la orientación de D-13: se valida en escritura.
  locationId   Int?
  locationPath String?

  // Federación A.5: documento como entregable de una tarea de proyecto (capa 1)
  // null cuando module ≠ PROJECTS o cuando todavía no fue vinculado.
  // Sin FK porque ProjectTask vive en mi-project.
  projectTaskId Int?

  // Relaciones
  currentDocumentType  DocumentType            @relation(fields: [currentDocumentTypeId], references: [id])
  currentDocumentClass DocumentClass?          @relation(fields: [currentDocumentClassId], references: [id])
  // `Restrict` explícito, por el mismo motivo: con `SetNull` eliminar un nodo
  // vaciaría en silencio la clasificación de cada documento que lo usaba, que es
  // exactamente lo que la migración declara que no debe pasar.
  location             DocLocation?            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  revisions            DocumentRevision[]
  taskDocumentRefs     TaskDocumentReference[]
  replacementItems     DocReplacementItem[]

  // Unicidad del código por dos índices ÚNICOS PARCIALES, creados en SQL porque
  // Prisma no los expresa (BLOQUE 02, B2):
  //   documents_code_projectId_key  UNIQUE (code, projectId) WHERE projectId IS NOT NULL
  //   documents_code_module_key     UNIQUE (code, module)    WHERE projectId IS NULL
  // Único por proyecto para los documentos en circulación; único por módulo para
  // los publicados. Reemplaza a [code, module, entityType, entityId], cuya tupla
  // con columnas anulables no impedía duplicados (H-19).
  @@index([projectId])
  @@index([module])
  @@index([currentDocumentClassId])
  @@index([projectTaskId])
  @@index([locationId])
  @@map("documents")
}

// Tabla puente N-a-N entre ProjectTask (mi-project) y Document (mi-document).
// Capa 2 de la federación A.5: documentos consumidos como insumo o referenciados.
// El entregable principal (capa 1) se modela con Document.projectTaskId.
model TaskDocumentReference {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  createdById Int // Referencia al User del sistema admin

  projectTaskId Int // Referencia a ProjectTask.id (sin FK, está en otro subgraph)
  documentId    Int
  role          TaskDocumentRole

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([projectTaskId, documentId, role])
  @@index([projectTaskId])
  @@index([documentId])
  @@map("task_document_references")
}

// Revisiones de un documento (A, B, C... o 0, 1, 2...)
model DocumentRevision {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  createdById Int // Referencia al User del sistema admin
  updatedAt   DateTime? @updatedAt
  updatedById Int       @default(1)

  documentId   Int
  revisionCode String // "A", "B", "C" o "0", "1", "2"
  status       RevisionStatus @default(DRAFT)
  approvedById Int?
  approvedAt   DateTime?

  // Metadata de IDENTIFICACIÓN de la revisión (BLOQUE 03B, B1). Vive acá y no en
  // el documento porque está impresa dentro del archivo: el rótulo lleva el
  // título y a menudo la clase y el tipo, y lo que está impreso en el archivo
  // pertenece a la emisión que lo produjo.
  //
  // Se copian de la revisión anterior al crear la nueva, y se editan libremente
  // mientras esté abierta. Aprobada, quedan congeladas POR ESTRUCTURA —una
  // revisión aprobada no se modifica—, sin necesidad de una precondición que lo
  // enuncie. Abandonar la revisión se lleva con ella lo que se editó.
  //
  // Los nombres van desnudos, a diferencia de los `current*` del documento: acá
  // el valor no es copia de nada, es el dato.
  title           String
  documentTypeId  Int
  documentClassId Int?

  // Armador designado al crear la revisión (BLOQUE 03, B3). Obligatorio: es el
  // único actor que debe conocerse en el alta, porque todo lo demás lo trae la
  // plantilla o lo decide el armado. Su valor por defecto lo aporta
  // DocProjectSettings.defaultOrganizerId. Referencia externa sin FK: User vive
  // en mi-admin. El paso de armado se reasigna después como cualquier otro (B9).
  assignedOrganizerId Int

  // Abandono de la revisión (BLOQUE 03, B11; renombrado en BLOQUE 03B, B11).
  // Solo desde DRAFT o IN_REVIEW: aprobada, la revisión es el documento vigente
  // y lo que corresponde es abrir la siguiente. El motivo vive en el modelo y no
  // en el meta de un evento (H-05).
  abandonedAt   DateTime?
  abandonedById Int?
  abandonReason String?

  // Relaciones
  document         Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentType     DocumentType       @relation(fields: [documentTypeId], references: [id])
  documentClass    DocumentClass?     @relation(fields: [documentClassId], references: [id])
  versions         DocumentVersion[]
  workflows        ReviewWorkflow[] // Varios circuitos sucesivos (D-11, B2)
  transmittalItems TransmittalItem[]
  workingCopies    DocWorkingCopy[] // A lo sumo una abierta (BLOQUE 03B, B12)

  // Unicidad del código por ÍNDICE ÚNICO PARCIAL, creado en SQL (BLOQUE 03, B12):
  //   document_revisions_code_key  UNIQUE (documentId, revisionCode) WHERE status <> 'ABANDONED'
  // La revisión abandonada no consume código: sobre A puede abrirse B, abandonarse
  // y volver a abrirse B. Un documento puede tener varias abandonadas con el mismo
  // código, y cada una se distingue por su fecha y su motivo.
  @@index([documentId])
  @@map("document_revisions")
}

// Versión: el CONJUNTO de archivos registrado en un mismo acto (BLOQUE 03B, B6).
//
// Un documento se entrega habitualmente como más de un archivo: el PDF que se
// revisa y se marca, con su editable en custodia y la evidencia que lo sustenta.
// El principio de D-10 no se debilita, se corrige su cardinalidad: la versión no
// existe sin contenido nuevo, y ni el conjunto ni sus archivos se modifican.
//
// Nace al CONFIRMAR una copia de trabajo (B12), y no al subir cada archivo.
model DocumentVersion {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  createdById Int // Referencia al User del sistema admin

  revisionId    Int
  versionNumber Int // 1, 2, 3...

  comment String? // "Corrección del conexionado en la página 5". Opcional (B4)

  // Relaciones
  revision DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  files    DocVersionFile[]
  // La copia de trabajo que la produjo, cuando nació de una (B12)
  workingCopy DocWorkingCopy?

  @@unique([revisionId, versionNumber])
  @@map("document_versions")
}

// Un archivo dentro del conjunto de la versión (BLOQUE 03B, B6 y B7).
model DocVersionFile {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  versionId Int
  role      DocFileRole

  fileKey  String // Key en DO Spaces
  fileName String // Nombre original del archivo
  fileSize Int // Tamaño en bytes
  mimeType String // "application/pdf", "image/vnd.dwg"

  // SHA-256, OBLIGATORIO en cada archivo, con el mismo fundamento que antes lo
  // volvía obligatorio en la versión (BLOQUE 03, B4 y H-27): es lo que la firma
  // acredita. Una regla condicional obligaría a decidir qué ocurre con el
  // archivo que entró sin él y después resulta ser el firmado.
  checksum String

  // Relaciones
  version DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  // Ningún archivo repetido dentro de la misma versión.
  @@unique([versionId, fileKey])
  @@index([versionId])
  @@map("doc_version_files")
}

// Copia de trabajo: el conjunto EN PREPARACIÓN (BLOQUE 03B, B12).
//
// Es lo que en la gestión documental se opera con check-out y check-in, con dos
// diferencias: acá NO descarga —leer un archivo nunca fue un acto del ciclo— y
// NO bloquea, porque la exclusividad ya la da el circuito, donde la versión la
// produce quien tiene el paso vigente (BLOQUE 03, B5).
//
// Mutable por naturaleza, y por eso NO es una versión: la versión debe ser
// inmutable una vez que existe, y lo que esta entidad resuelve es cuándo existe.
model DocWorkingCopy {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  createdById Int // Quien la abrió. Referencia al User del sistema admin

  revisionId Int

  // Confirmación: el conjunto se convierte en la versión siguiente.
  confirmedAt   DateTime?
  confirmedById Int?
  versionId     Int? @unique // La versión que produjo, cuando se confirmó

  // Descarte: se abandona sin producir versión. Palabra propia del nivel (B11).
  discardedAt   DateTime?
  discardedById Int?
  discardReason String?

  // Relaciones
  revision DocumentRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  version  DocumentVersion?     @relation(fields: [versionId], references: [id], onDelete: SetNull)
  files    DocWorkingCopyFile[]

  // A lo sumo UNA abierta por revisión, por ÍNDICE ÚNICO PARCIAL creado en SQL:
  //   doc_working_copies_open_key  UNIQUE (revisionId)
  //                                WHERE confirmedAt IS NULL AND discardedAt IS NULL
  // Es el mismo invariante que el módulo ya aplica dos veces —a lo sumo una
  // revisión en curso por documento, a lo sumo un circuito abierto por revisión—
  // apareciendo en un tercer nivel.
  @@index([revisionId])
  @@map("doc_working_copies")
}

// Un archivo dentro de la copia de trabajo. Misma forma que DocVersionFile: al
// confirmar se copia tal cual, incluidos `fileKey` y `checksum`, de modo que un
// archivo que no cambió NO se vuelve a subir (BLOQUE 03B, B12).
model DocWorkingCopyFile {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  workingCopyId Int
  role          DocFileRole

  fileKey  String
  fileName String
  fileSize Int
  mimeType String
  checksum String

  // Relaciones
  workingCopy DocWorkingCopy @relation(fields: [workingCopyId], references: [id], onDelete: Cascade)

  @@unique([workingCopyId, fileKey])
  @@index([workingCopyId])
  @@map("doc_working_copy_files")
}

// Acto de reemplazo entre documentos (BLOQUE 03B, B5).
//
// Reemplazar es SUPERAR: el documento reemplazado queda obsoleto en el mismo
// acto. Es el mismo hecho que un nivel más abajo ocurre al aprobar una revisión,
// que supersede a la anterior.
//
// Es un ACTO y no un par de referencias: sin la agrupación, una reorganización
// de dos documentos en dos es indistinguible de dos reemplazos separados.
model DocReplacement {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  createdById Int // Referencia al User del sistema admin

  // Obligatorio, con el criterio del §9 para todo acto consecuente.
  reason String

  // NO declara de qué clase de reemplazo se trata —recodificación, unificación,
  // división—: se DERIVA de su cardinalidad. Un indicador sería un dato
  // calculable capaz de contradecir a los que lo originan (criterio de D-04).

  // Relaciones
  items DocReplacementItem[]

  @@map("doc_replacements")
}

// Los documentos que participan del acto, con su papel. La relación es N:M: el
// mismo acto expresa la recodificación (1:1), la unificación (N:1) y la división
// (1:N). Los documentos de un acto COMPARTEN ÁMBITO: lo que cruza de proyecto al
// régimen de publicación no es reemplazo sino promoción, que es otra cosa (B10).
model DocReplacementItem {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  replacementId Int
  documentId    Int
  role          DocReplacementRole

  // Relaciones
  replacement DocReplacement @relation(fields: [replacementId], references: [id], onDelete: Cascade)
  document    Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Un documento no aparece dos veces con el mismo papel dentro de un acto.
  @@unique([replacementId, documentId, role])
  @@index([documentId])
  @@map("doc_replacement_items")
}

// Circuito de revisión (ISO 9001). Bajo BLOQUE 03, B1 abarca el ciclo completo:
// se instancia CON LA REVISIÓN y no con la sumisión, y arranca en el armado.
// Una revisión admite varios circuitos sucesivos (D-11, B2): el rechazo abre uno
// desde PREPARE con el mismo elenco copiado, y la cancelación uno desde ASSIGN.
model ReviewWorkflow {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  revisionId    Int
  status        WorkflowStatus @default(IN_PROGRESS) // El circuito nace iniciado (B2)
  initiatedById Int
  initiatedAt   DateTime       @default(now())
  completedAt   DateTime?

  // Plantilla propuesta al instanciarse (BLOQUE 03, B3). Solo referencia de
  // procedencia: los valores SE COPIAN al materializarse los pasos, de modo que
  // cambiar la plantilla no altera circuitos en curso.
  templateId Int?

  // Cancelación del circuito (BLOQUE 03, B11), distinguible del rechazo. Se
  // admite en cualquier punto, aun con pasos firmados: nada se elimina.
  cancelledAt   DateTime?
  cancelledById Int?
  cancelReason  String?

  // Relaciones
  revision DocumentRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  steps    ReviewStep[]
  template DocWorkflowTemplate? @relation(fields: [templateId], references: [id])

  // Un solo circuito abierto por revisión, por ÍNDICE ÚNICO PARCIAL en SQL (B2):
  //   review_workflows_open_revision_key  UNIQUE (revisionId) WHERE status = 'IN_PROGRESS'
  // Reemplaza al @unique de revisionId, que admitía un solo circuito por revisión
  // y dejaba al documento rechazado sin salida (H-01). El circuito vigente se
  // DERIVA: no se almacena un currentWorkflowId, que podría desincronizarse.
  @@index([revisionId])
  @@index([templateId])
  @@map("review_workflows")
}

// Pasos individuales del circuito. Su estructura es inmutable una vez armada
// (B9): no se agregan, quitan ni reordenan. Lo único editable es el actor.
model ReviewStep {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  workflowId   Int
  stepOrder    Int // Orden de ejecución
  stepType     StepType // ASSIGN, PREPARE, REVIEW, APPROVE, ACKNOWLEDGE
  assignedToId Int // Referencia al User del sistema admin
  status       StepStatus @default(PENDING)
  comments     String?
  completedAt  DateTime?

  // Quién resolvió efectivamente el paso (BLOQUE 03, B9). Siempre informado al
  // resolverse; nulo mientras el paso está pendiente. La delegación se DERIVA de
  // la divergencia con assignedToId: un booleano sería un dato calculable que
  // puede contradecir a los dos campos que lo originan.
  resolvedById Int?

  // Motivo, obligatorio cuando quien resuelve no es el asignado (B9). Se
  // conserva acá y dentro del payload firmado.
  delegationReason String?

  // El signatureHash se trasladó a DocStepSignature (B7): un hash sin sus
  // insumos no es verificable, que es el defecto de H-06.

  // Relaciones
  workflow  ReviewWorkflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  signature DocStepSignature?

  @@unique([workflowId, stepOrder])
  @@index([assignedToId])
  @@map("review_steps")
}

// Firma de un paso (BLOQUE 03, B7 y D-05). Objeto propio, uno por firma,
// referenciado por el paso: la firma es evidencia INMUTABLE y el paso se sigue
// actualizando, de modo que separarlos permite declararla inmutable sin
// excepciones y le da su propio tipo de objeto en la traza.
//
// Firman los pasos que actúan sobre una versión —PREPARE, REVIEW, APPROVE y
// ACKNOWLEDGE—. ASSIGN NO firma: al completarse puede no existir todavía
// ninguna versión, de modo que no habría objeto que acreditar.
//
// Ninguna firma afirma nada sobre las versiones posteriores: cada una acredita
// aquella sobre la que actuó su autor.
model DocStepSignature {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  createdById Int // Coincide con ReviewStep.resolvedById

  stepId Int @unique // Un paso se resuelve una sola vez

  // Payload canónico SERIALIZADO tal como se usó para calcular el hash, más el
  // algoritmo. Es texto y no Json a propósito: jsonb normaliza y reordena las
  // claves, con lo que el hash dejaría de poder recalcularse sobre lo guardado.
  //
  // Contenido: el paso, su circuito y su revisión; la versión vigente al firmar
  // con su número, fileKey y checksum; la metadata del documento vigente al
  // firmar (B6); el usuario asignado y el que resolvió, con el motivo cuando
  // difieren; y la acción —aprobación o rechazo— con su momento.
  algorithm String @default("SHA-256")
  payload   String @db.Text
  hash      String

  // Relaciones
  step ReviewStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("doc_step_signatures")
}

// Transmittals de ingeniería
model Transmittal {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  updatedById Int       @default(1)

  // Código propio, único POR PROYECTO (BLOQUE 04, B2). La numeración global era
  // la mitad de H-16: el transmittal pertenece a un proyecto, que es la unidad
  // contractual. La otra mitad —el cálculo fuera de la transacción— la cierra
  // el resolver, con este índice como árbitro.
  code      String // "TR-001", por proyecto
  projectId Int // Referencia externa al subgraph projects

  nature TransmittalNature
  status TransmittalStatus @default(DRAFT)

  // Cómo la contraparte nombra este transmittal en SU sistema. Aplica a los dos
  // casos entrantes —la emisión del contratista en modo Receptor y la respuesta
  // del cliente en modo Emisor— y es un dato del remito ajeno, no un remito
  // propio: el mismo criterio con que D-20 conserva la referencia externa del
  // paquete de información de entrada.
  counterpartyReference String?

  // La emisión que esta respuesta contesta (B1). Nulo en las emisiones, y
  // exigido en las respuestas: es lo que vuelve inequívoca la naturaleza sin
  // necesidad de marcarla de otro modo.
  respondsToTransmittalId Int?

  // `issuedTo` se retira: el destinatario de una emisión es la contraparte del
  // proyecto, que es única (D-15) y vive en DocProjectSettings.counterpartyName.
  // Guardarla por registro permitía que dos transmittals del mismo proyecto
  // declararan destinatarios distintos, que es lo que la unidad contractual
  // considera inválido. Cierra B11 de BLOQUE 02 en la dirección que anticipó.
  issuedById Int // Referencia al User del sistema admin
  issuedAt   DateTime?

  // Acuse de recibo (BLOQUE 04, B8). Da operación al ACKNOWLEDGED que hoy
  // ninguna asigna (H-12).
  //
  // NO es una calificación: no dice nada sobre el documento, dice que el envío
  // llegó. Forzarlo dentro del catálogo de D-22 lo dejaría en la cuarta
  // combinación de efectos que esa decisión declara inexistente —no habilita
  // nada y no obliga a nada— y rompería la regla que les da sentido.
  //
  // Solo tiene sentido en modo Emisor, donde la emisión viaja afuera y no se
  // sabe si llegó. En modo Receptor el contratista carga el transmittal dentro
  // del sistema, y el acto equivalente es la confirmación de la recepción.
  //
  // Misma autoría diferenciada que la respuesta, por el mismo motivo de D-12:
  // quien acusa es el cliente y no es usuario del sistema.
  acknowledgedBy            String?
  acknowledgedAt            DateTime? // Fecha real del acuse
  acknowledgeRegisteredById Int?
  acknowledgeRegisteredAt   DateTime? // Fecha de registro

  // Cierre (BLOQUE 04, B10). Acto documental EXPLÍCITO y no derivado: las
  // respuestas parciales son la práctica normal, de modo que un cierre que
  // esperara a que todos los ítems tuvieran respuesta no ocurriría nunca.
  //
  // Cerrar declara que se dejó de esperar, no que se dejó de escuchar: una
  // calificación tardía se registra igual sobre un transmittal cerrado.
  closedAt    DateTime?
  closedById  Int?
  closeReason String?

  // Relaciones
  items TransmittalItem[]

  respondsTo Transmittal?  @relation("TransmittalResponse", fields: [respondsToTransmittalId], references: [id])
  responses  Transmittal[] @relation("TransmittalResponse")

  // Las respuestas que este transmittal transportó, cuando es de naturaleza
  // RESPONSE. No son ítems propios: son las respuestas de los ítems de la
  // emisión que contesta (B5).
  carriedResponses DocTransmittalResponse[] @relation("CarriedResponses")

  @@unique([projectId, code])
  @@index([projectId])
  @@index([respondsToTransmittalId])
  @@map("transmittals")
}

// Items de un transmittal
model TransmittalItem {
  id Int @id @default(autoincrement())

  transmittalId Int

  // Una revisión se emite UNA SOLA VEZ (BLOQUE 04, B3): la unicidad reemplaza a
  // [transmittalId, documentRevisionId], que solo impedía el duplicado dentro
  // del mismo transmittal. Es un índice sin condiciones porque solo los
  // transmittals de emisión llevan ítems.
  //
  // Absorbe dos reglas que estaban planteadas por separado: una revisión
  // respondida tampoco vuelve a emitirse —ya salió— y un reintento del emisor no
  // puede duplicar la emisión.
  //
  // Quitar el ítem, posible solo en borrador, libera la revisión.
  documentRevisionId Int         @unique
  purposeCode        PurposeCode

  // Relaciones
  //
  // `clientStatus` y `clientComments` se retiran (BLOQUE 04, B5): la respuesta
  // dejó de ser dos columnas del ítem y pasó a ser un objeto propio, con sus
  // archivos, su autoría diferenciada y su fecha real.
  transmittal      Transmittal             @relation(fields: [transmittalId], references: [id], onDelete: Cascade)
  documentRevision DocumentRevision        @relation(fields: [documentRevisionId], references: [id])
  response         DocTransmittalResponse?

  @@index([transmittalId])
  @@map("transmittal_items")
}

// Adjuntos simples (evidencias, fotos, archivos de soporte)
model Attachment {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  createdById Int
  module      ModuleType
  entityType  String     @db.VarChar(100)
  entityId    Int
  fileKey     String     @db.VarChar(500)
  fileName    String     @db.VarChar(300)
  fileSize    Int
  mimeType    String     @db.VarChar(100)
  description String?    @db.VarChar(500)

  @@index([module, entityType, entityId])
  @@map("attachments")
}

// ================================
// CONTEXTO DE PROYECTO — BLOQUE 02
// ================================

// Configuración documental de un proyecto (D-09, D-19).
// Un registro por proyecto. Es además el lugar donde residirán el esquema de
// revisión (D-13) y la configuración de ubicación física (D-14).
model DocProjectSettings {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  createdById Int
  updatedAt   DateTime? @updatedAt
  updatedById Int       @default(1)

  // Referencia externa sin FK: Project vive en mi-project
  projectId Int @unique

  documentRole DocumentRole

  // Nombre de la contraparte: cliente en ISSUER, contratista en RECEIVER.
  // Exigido por invariante en ISSUER y RECEIVER; prohibido en INTERNAL,
  // que por definición no tiene contraparte.
  counterpartyName String?

  // Esquema con que el proyecto propone el código de la PRIMERA revisión de sus
  // documentos (BLOQUE 03, B13). Nulo = rige el valor por defecto del despliegue
  // (DocSettings). De la segunda revisión en adelante el esquema se infiere de la
  // última revisión no abortada, que es el escalón del documento.
  revisionScheme RevisionScheme?

  // Armador por defecto del proyecto —habitualmente el jefe de proyecto—, con el
  // que el alta llega con el campo lleno (B3). Nulo = sin valor por defecto, y
  // quien crea el documento debe designarlo. Referencia externa sin FK.
  defaultOrganizerId Int?

  // Configuración del atributo de ubicación física (BLOQUE 02B, B4).
  //
  // Habilitado y NO obligatorio por defecto, en los tres roles. Se corrige acá la
  // expectativa de D-14 de que "una planta lo exigirá": la planta lo usa para
  // filtrar, no para exigir. Un proyecto atraviesa el ciclo completo sin declarar
  // ninguna ubicación.
  //
  // La etiqueta sí es configurable, a diferencia del esquema de revisión: "área",
  // "unidad" o "sector" son nombres que cada organización usa distinto, mientras
  // que "revisión" es terminología establecida del dominio documental.
  locationEnabled  Boolean @default(true)
  locationRequired Boolean @default(false)
  locationLabel    String?

  @@map("doc_project_settings")
}

// ================================
// CICLO INTERNO — BLOQUE 03
// ================================

// Configuración documental del despliegue (BLOQUE 03, B13 y Q23).
// REGISTRO ÚNICO, con el patrón de CatalogSettings de digitalización: fija la
// convención del cliente sin desplegar y sin configurar proyecto por proyecto.
// Es el último escalón de la precedencia documento ▸ proyecto ▸ despliegue.
model DocSettings {
  id          Int       @id @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  updatedById Int       @default(1)

  // Esquema con que se propone el código de una primera revisión cuando el
  // proyecto no declara el suyo. SIN etiqueta configurable: "revisión" es
  // terminología establecida del dominio documental (B13).
  revisionScheme RevisionScheme @default(ALPHA)

  @@map("doc_settings")
}

// Plantilla del circuito (BLOQUE 03, B3). PROPONE el circuito; el armado lo
// define. Sin ella el armador declararía el circuito paso por paso en cada
// documento, que es el trabajo que el control documental no puede asumir.
//
// Alcance por proyecto, con refinamiento por clase y por tipo de documento:
// se resuelve contra la tupla del propio documento y GANA LA MÁS ESPECÍFICA
// —tipo, después clase, después proyecto—. La plantilla del proyecto con clase
// y tipo nulos ES su default, sin necesidad de una marca aparte.
//
// projectId nulo alcanza a los documentos del régimen de publicación (BLOQUE 02,
// B1), que no pertenecen a ningún proyecto.
model DocWorkflowTemplate {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  createdById  Int
  updatedAt    DateTime? @updatedAt
  updatedById  Int       @default(1)
  terminatedAt DateTime?
  isSys        Boolean   @default(false)

  name        String
  description String?

  // Alcance. Referencia externa sin FK para projectId: Project vive en mi-project.
  projectId       Int?
  documentClassId Int?
  documentTypeId  Int?

  // Relaciones
  documentClass DocumentClass?            @relation(fields: [documentClassId], references: [id])
  documentType  DocumentType?             @relation(fields: [documentTypeId], references: [id])
  steps         DocWorkflowTemplateStep[]
  workflows     ReviewWorkflow[]

  // Unicidad del alcance, recreada con NULLS NOT DISTINCT en la migración (B3).
  // Sin la cláusula, la tupla con columnas anulables repetiría el defecto de H-19.
  // Acá corresponde y en B2 de BLOQUE 02 no: allá una sola tupla expresaba dos
  // reglas distintas; acá es una única regla con refinamientos opcionales.
  @@unique([projectId, documentClassId, documentTypeId], map: "doc_workflow_templates_scope_key") // NULLS NOT DISTINCT en la base
  @@index([projectId])
  @@index([documentClassId])
  @@index([documentTypeId])
  @@map("doc_workflow_templates")
}

// Pasos de la plantilla: orden, tipo y actor preasignado opcional.
//
// NO incluye el armado ni la elaboración: esos dos pasos los pone el sistema,
// según el rol documental del proyecto —en el rol Receptor no hay elaboración
// (B16)—. Una plantilla que pudiera omitirlos permitiría circuitos sin elaborador.
//
// El ELABORADOR NUNCA SE PREASIGNA: designarlo es distribuir carga de trabajo y
// se decide documento por documento. Por eso el armado tiene contenido incluso
// con la plantilla más completa, y por eso siempre existe.
model DocWorkflowTemplateStep {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  templateId Int
  stepOrder  Int

  // Solo REVIEW, APPROVE y ACKNOWLEDGE. ASSIGN y PREPARE los pone el sistema.
  stepType StepType

  // Actor preasignado, opcional. Nulo = lo designa el armado.
  // Referencia externa sin FK: User vive en mi-admin.
  assignedToId Int?

  // Relaciones
  template DocWorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, stepOrder])
  @@map("doc_workflow_template_steps")
}

// Membresía documental de un proyecto (D-15).
// Habilita el acceso de un usuario a un proyecto y declara de qué lado está.
// NO define rol ni permisos: provienen del servicio de administración global.
// La autorización efectiva combina el permiso global con la membresía vigente.
//
// Es una lista distinta de la membresía de mi-project, que registra personal
// propio asignado y no contempla externos. No se deriva ni se sincroniza con ella.
model DocProjectMember {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  updatedById Int       @default(1)
  isSys       Boolean   @default(false)

  // Referencias externas sin FK: Project vive en mi-project, User en mi-admin
  projectId Int
  userId    Int

  // En proyectos INTERNAL todos los miembros son HOST, incluidas las personas
  // ajenas a la organización que participen del desarrollo (D-19).
  side DocProjectSide

  assignedAt   DateTime  @default(now())
  assignedById Int
  isActive     Boolean   @default(true)
  revokedAt    DateTime?
  revokedById  Int?

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("doc_project_members")
}

// ================================
// EMISIÓN Y RESPUESTA — BLOQUE 04
// ================================

// Efecto de una calificación de la contraparte (BLOQUE 04, B11).
//
// Lo que cambia el tratamiento aguas abajo son DOS preguntas independientes
// —¿habilita usar el documento? ¿obliga a emitir una revisión nueva?— y solo
// TRES de sus cuatro combinaciones existen: si el documento no sirve, hay que
// volver a emitirlo.
//
// Por eso se modela como enumeración y no como dos indicadores. Con dos
// booleanos la cuarta combinación puede escribirse en la base y hay que
// impedirla por validación; acá no puede expresarse. Es el criterio de D-13:
// sin atributo, la incoherencia no puede existir.
enum QualificationEffect {
  ACCEPTED // Habilita usar el documento. No obliga a emitir revisión nueva
  ACCEPTED_WITH_COMMENTS // Habilita usar el documento y obliga a emitir revisión nueva
  REJECTED // No habilita usar el documento y obliga a emitir revisión nueva
}

// Calificación con que la contraparte responde una emisión (BLOQUE 04, B11).
//
// Reemplaza a la enumeración fija ClientStatus: cada cliente tiene su propio
// juego de calificaciones, con SUS códigos y SU cantidad, y el rótulo que el
// usuario ve es el del cliente y no una traducción nuestra. El código y el
// rótulo son lo que el usuario ve; el efecto es lo único que el sistema
// interpreta.
//
// Sirve a los dos modos con el mismo catálogo, que es la razón para modelarlo
// una sola vez: en RECEIVER la planta emite la calificación al cerrar el
// circuito, en ISSUER el control documental transcribe la que el cliente
// devolvió (D-12).
model DocQualification {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  createdById  Int
  updatedAt    DateTime? @updatedAt
  updatedById  Int       @default(1)
  terminatedAt DateTime?
  isSys        Boolean   @default(false)

  // Alcance. Nulo = catálogo del despliegue. Referencia externa sin FK:
  // Project vive en mi-project.
  //
  // SIN HERENCIA, a diferencia de D-21: el proyecto que declara una calificación
  // propia usa las suyas y SOLO las suyas. La lista de calificaciones es la del
  // contrato, y una lista mezclada —cuatro del despliegue más tres del cliente—
  // no es la de nadie y admite calificar con un valor que la contraparte no usa.
  projectId Int?

  code   String // El de la contraparte: "A", "B", "1", "APROBADO"...
  label  String // El rótulo que el usuario ve, tal como lo escribe el cliente
  effect QualificationEffect

  // El orden es el de la lista del cliente, no el alfabético.
  sortOrder Int @default(0)

  // Unicidad del código dentro de su alcance, recreada con NULLS NOT DISTINCT en
  // la migración: sin la cláusula, dos calificaciones del despliegue con el mismo
  // código no chocarían, que es el defecto de H-19.
  // Relaciones
  responses DocTransmittalResponse[]

  @@unique([code, projectId], map: "doc_qualifications_code_scope_key") // NULLS NOT DISTINCT en la base
  @@index([projectId])
  @@map("doc_qualifications")
}

// Respuesta de la contraparte sobre un documento emitido (BLOQUE 04, B5).
//
// Objeto propio del ÍTEM y no una versión de la revisión. La regla que lo decide
// vale para los dos modos con un solo enunciado (B6): un archivo producido
// DENTRO del circuito, por quien tiene el paso vigente, es una versión; un
// archivo que llega de AFUERA del circuito es evidencia de una respuesta.
//
// En modo Emisor el cliente no tiene paso ni firma nuestra, de modo que lo que
// vuelve es evidencia. En modo Receptor la misma regla da el resultado
// contrario, y las marcas de la planta sí son versiones: el revisor está
// adentro.
//
// Colgar del ítem hace que H-14 desaparezca por construcción: no existe la
// operación que actualizaba ítems por identificador sin verificar a qué
// transmittal pertenecían.
model DocTransmittalResponse {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // Una respuesta por ítem: la contraparte califica una emisión UNA vez.
  // Corregirla es editar esta, no abrir otra.
  transmittalItemId Int @unique

  // Único dato obligatorio. El archivo es opcional —un rechazo trae el plano
  // marcado, un sello de aprobado no trae nada— pero una respuesta sin
  // calificación y sin archivo no registra ningún hecho.
  qualificationId Int

  comments String?

  // Quién respondió, COMO TEXTO. Lo exige el caso habitual de D-12: el cliente
  // que responde por correo o por un repositorio compartido no es usuario del
  // sistema y no tiene User que lo represente.
  respondedBy String?

  // Fecha real de la respuesta, frente a `createdAt` que es la de registro. La
  // transcripción es siempre posterior (H-33). Nula cuando no se conoce.
  respondedAt DateTime?

  // Quién la registró, ese sí como referencia a User: en el caso habitual es el
  // control documental de la ingeniería. La divergencia con `respondedBy` se
  // DERIVA de que ambos existan, en lugar de almacenarse como indicador (D-04).
  registeredById Int
  updatedById    Int @default(1)

  // El sobre en que viajó, si vino consolidada (D-18). Nulo en la vía documento
  // a documento, que es la práctica actual. Es lo que unifica las dos formas con
  // un solo objeto: la respuesta es siempre del documento, y el transmittal de
  // respuesta es apenas el sobre.
  responseTransmittalId Int?

  // Relaciones
  transmittalItem     TransmittalItem  @relation(fields: [transmittalItemId], references: [id], onDelete: Cascade)
  qualification       DocQualification @relation(fields: [qualificationId], references: [id])
  responseTransmittal Transmittal?     @relation("CarriedResponses", fields: [responseTransmittalId], references: [id])
  files               DocResponseFile[]

  @@index([qualificationId])
  @@index([responseTransmittalId])
  @@map("doc_transmittal_responses")
}

// Archivos que devuelve la contraparte (BLOQUE 04, B5 y B6).
//
// No son ninguno de los tres roles de D-25 —no son entregable, ni fuente, ni
// respaldo— porque no integran la entrega: son lo que la contraparte dijo SOBRE
// la entrega. Por eso cuelgan de la respuesta y no de la versión.
//
// `checksum` es opcional, a diferencia del archivo de una versión: nadie firma
// la respuesta, de modo que no hay firma cuya verificabilidad dependa de él.
model DocResponseFile {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  responseId Int

  fileKey  String
  fileName String
  fileSize Int
  mimeType String
  checksum String?

  response DocTransmittalResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, fileKey])
  @@index([responseId])
  @@map("doc_response_files")
}

// ================================
// UBICACIÓN FÍSICA — BLOQUE 02B
// ================================

// Los catálogos documentales cuyo alcance el proyecto declara (BLOQUE 02B, B1).
//
// El mecanismo es UNO para los tres. `LOCATION` lo estrena BLOQUE 02B, sobre el
// catálogo que no tiene datos ni interfaz en producción; `BLOCK_02C` incorpora
// los otros dos, y no le cuesta una columna sino un valor de esta enumeración.
enum DocCatalogKind {
  LOCATION
  DOCUMENT_CLASS
  DOCUMENT_TYPE
}

// Cómo resuelve un proyecto un catálogo (BLOQUE 02B, B1).
//
// `INHERIT` es vínculo vivo: las entradas del despliegue aparecen siempre, más
// las que el proyecto agregue. `OWN` es sin vínculo: el proyecto no ve nada del
// despliegue. La siembra por copia (B2) es puntual y no un tercer modo — una
// copia permanente ES herencia.
enum DocScopeMode {
  INHERIT
  OWN
}

// Cómo resuelve un proyecto cada catálogo documental (BLOQUE 02B, B1).
//
// UNA FILA POR PROYECTO Y CATÁLOGO, y no columnas en `DocProjectSettings`: B1
// sostiene que el mecanismo es uno para los tres catálogos, y esta es la única
// forma en que eso es cierto en el modelo. `BLOCK_02C` lo reutiliza agregando
// valores a `DocCatalogKind`, sin migrar estructura.
//
// Es además la distinción que D-21 ya había hecho: las demás configuraciones por
// proyecto —el rol, el esquema de revisión, el armador por defecto— son VALORES
// donde lo específico reemplaza a lo general, y viven en `DocProjectSettings`.
// Un catálogo es un CONJUNTO, y lo que se declara es si se hereda o no.
//
// LA AUSENCIA DE FILA ES `INHERIT`. No se exige declarar nada para operar, y es
// lo que vuelve aditiva la migración: todo proyecto existente hereda.
model DocCatalogScope {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  createdById Int
  updatedAt   DateTime? @updatedAt
  updatedById Int       @default(1)

  // Referencia externa sin FK: Project vive en mi-project.
  projectId Int

  catalog DocCatalogKind
  mode    DocScopeMode

  @@unique([projectId, catalog])
  @@index([projectId])
  @@map("doc_catalog_scopes")
}

// De dónde viene el objeto que un nodo describe, cuando describe uno (B7).
//
// `ASSETS` es el registro de activos de OperMask, dueño del árbol cuando ese
// módulo existe; `EXTERNAL`, un sistema ajeno al ecosistema. Externo es respecto
// de ESTE módulo, que es el que resuelve la referencia.
enum DocLocationOrigin {
  ASSETS
  EXTERNAL
}

// Catálogo de ubicación física del documento (BLOQUE 02B, B5 a B7).
//
// Jerárquico y auto-referencial —sitio ▸ planta ▸ área ▸ unidad—, con el patrón
// de `CatalogReference` (DOM-024) de digitalización. La profundidad es LIBRE: se
// carga como lista plana de un nivel o como árbol de varios, según cómo cada
// organización describa su instalación. El sitio no es una entidad aparte: es el
// nivel superior del mismo árbol (D-14).
//
// Es un catálogo de CLASIFICACIÓN y no un registro de activos (B8): afirma cómo
// nombra el cliente sus sectores, no que un equipo exista y sea propio. Por eso
// convive con el árbol que administrará el módulo de activos sin contradecirlo
// —la divergencia entre un catálogo de clasificación y un registro de activos no
// es un defecto, porque no dicen lo mismo—.
//
// NO reutiliza `Area`, que es plana, obligatoriamente atada al proyecto y
// pertenece al subsistema de `ScannedFile` que sale del módulo.
model DocLocation {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  createdById  Int
  updatedAt    DateTime? @updatedAt
  updatedById  Int       @default(1)
  terminatedAt DateTime?
  isSys        Boolean   @default(false)

  // Alcance (BLOQUE 02B, B1). Nulo = árbol del despliegue, del que los proyectos
  // heredan. Con valor, el nodo lo agregó ese proyecto. Referencia externa sin
  // FK: Project vive en mi-project.
  //
  // La relación de padre puede CRUZAR alcances en un solo sentido: un nodo del
  // proyecto cuelga de uno del despliegue, que es lo que significa *ampliar*. Al
  // revés no, porque volvería el árbol global dependiente de un proyecto. La
  // invariante no es expresable en un CHECK —exige mirar el padre— y vive en la
  // operación, con su prueba.
  projectId Int?

  // Jerarquía. Nulo = nodo raíz.
  parentId Int?

  code String
  name String

  // Ruta completa: los nombres de los ascendientes y el propio, separados por
  // " / ". Es DENORMALIZACIÓN de conveniencia y no evidencia (B6) —evita el
  // recorrido recursivo en cada listado—, de modo que renombrar o mover un nodo
  // recalcula las rutas de su descendencia de forma automática, sin propagación
  // explícita ni auditada. La ubicación se edita siempre y no entra en el
  // payload de la firma (B3), así que no hay inmutabilidad que respetar.
  path String

  sortOrder Int @default(0)

  // Referencia al objeto de otro sistema que este nodo describe (B7). Los dos
  // campos viajan juntos: un origen sin identificador no dice nada.
  //
  // Es el puente con el registro de activos —su dueño cuando ese módulo exista—
  // y con un sistema documental externo. Se modela desde el principio porque
  // cuesta dos columnas, y porque el precedente disponible
  // —`ScannedFile.externalReference`, una cadena más una URL armada por variable
  // de entorno— no modela el concepto.
  externalOrigin DocLocationOrigin?
  externalRef    String?

  // Relaciones
  // `Restrict` explícito y NO el `SetNull` que Prisma pone por defecto en una
  // relación opcional: eliminar un nodo con descendencia se rechaza, y la base no
  // debe resolverlo desprendiendo la rama en silencio. La operación lo verifica
  // antes para dar mensaje; esto es la garantía.
  parent    DocLocation?  @relation("DocLocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  DocLocation[] @relation("DocLocationTree")
  documents Document[]

  // Unicidad del código dentro de su nivel Y de su alcance, recreada con NULLS
  // NOT DISTINCT en la migración: sin la cláusula los nodos RAÍZ del despliegue
  // —donde las dos columnas son nulas, y que son todos los de un catálogo plano—
  // no se considerarían duplicados, que es el defecto de H-19.
  //
  // El alcance entra en la tupla porque dos proyectos pueden nombrar igual su
  // propio nodo, y porque un proyecto puede agregar un código que el despliegue
  // no tiene sin chocar con otro proyecto.
  @@unique([code, parentId, projectId], map: "doc_locations_code_level_key") // NULLS NOT DISTINCT en la base
  @@index([parentId])
  @@index([path])
  @@index([projectId])
  @@map("doc_locations")
}

// ================================
// EVENTOS DE DOMINIO — BLOQUE 01
// ================================

// Objetos del subsistema de Gestión Documental sobre los que se emiten eventos
enum DocObjectType {
  DOCUMENT
  DOCUMENT_REVISION
  DOCUMENT_VERSION
  REVIEW_WORKFLOW
  REVIEW_STEP
  TRANSMITTAL
  DOCUMENT_CLASS
  DOCUMENT_TYPE
  DOC_PROJECT_SETTINGS
  DOC_PROJECT_MEMBER

  // Ciclo interno (BLOQUE 03)
  DOC_STEP_SIGNATURE
  DOC_WORKFLOW_TEMPLATE
  DOC_SETTINGS

  // Titularidad por nivel (BLOQUE 03B). El acto de reemplazo tiene identidad
  // propia y toca VARIOS documentos: colgar su traza de uno de ellos obligaría a
  // elegir cuál, y la elección sería arbitraria.
  //
  // La copia de trabajo NO tiene tipo propio: su traza cuelga de la revisión,
  // porque no es un objeto del dominio sino el conjunto en preparación de esa
  // revisión, y lo que se consulta es qué le pasó a la revisión.
  DOC_REPLACEMENT

  // Emisión y respuesta (BLOQUE 04). El catálogo de calificaciones tiene traza
  // propia: es configuración del contrato, y quién agregó o dio de baja una
  // calificación explica por qué una respuesta pudo registrarse con ese valor.
  //
  // La respuesta también, y no cuelga del transmittal: es de un documento
  // concreto, y su traza describe ese documento y no la carpeta en que salió.
  DOC_QUALIFICATION
  DOC_TRANSMITTAL_RESPONSE

  // Ubicación física (BLOQUE 02B). El nodo tiene traza propia: quién agregó,
  // renombró, movió o dio de baja una ubicación explica por qué un documento
  // quedó clasificado donde está, y el recálculo de rutas alcanza a nodos que
  // nadie tocó.
  //
  // El alcance del catálogo también: declarar que un proyecto deja de heredar
  // cambia qué entradas tiene disponibles sin tocar ninguna entrada, y sin
  // registro ese cambio sería inexplicable después.
  DOC_LOCATION
  DOC_CATALOG_SCOPE
}

// Transición de estado de un objeto del dominio documental.
// Responde qué objeto cambió, desde qué estado y hacia cuál. Inmutable.
model DocWorkflowEvent {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  createdById Int? // nulo si lo emite el sistema

  objectType DocObjectType
  objectId   Int
  name       String // p. ej. RevisionApproved, TransmittalIssued
  fromState  String?
  toState    String?

  // Contexto del objeto afectado (BLOQUE 02, B9). Ambos DERIVADOS del objeto y
  // nunca informados por quien emite, que es lo que impide que reaparezca H-24.
  // projectId aísla la traza de un proyecto y alimenta el alcance por membresía;
  // module la aísla por módulo, y es el único eje cuando no hay proyecto.
  // Nulos en los catálogos, que no pertenecen a ningún proyecto y cuyo módulo
  // es opcional, y en los documentos del régimen de publicación.
  projectId Int?
  module    ModuleType?

  @@index([objectType, objectId, createdAt])
  @@index([projectId, createdAt])
  @@index([module, createdAt])
  @@map("doc_workflow_events")
}

// Acción ejecutada por un usuario o por el sistema sobre un objeto del dominio documental.
// Responde quién hizo qué y cuándo. Inmutable.
model DocAuditEvent {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  createdById Int? // nulo si lo emite el sistema

  objectType DocObjectType
  objectId   Int?
  action     String // p. ej. CreateDocument, ApproveStep
  meta       Json?

  // Contexto del objeto afectado (BLOQUE 02, B9). Mismo criterio que en
  // DocWorkflowEvent: derivados del objeto, nunca informados por quien emite.
  projectId Int?
  module    ModuleType?

  @@index([objectType, objectId, createdAt])
  @@index([createdById, createdAt])
  @@index([projectId, createdAt])
  @@index([module, createdAt])
  @@map("doc_audit_events")
}

enum DigitalDisposition {
  PENDING // Sin clasificar
  BAD_QUALITY // Imagen de mala calidad, requiere re-escaneo
  ACCEPTED // Aceptado, pendiente de carga en sistema externo
  UPLOADED // Cargado en sistema externo, ciclo cerrado
  DISCARDED // Descartado, sin valor documental
  LOST // Documento sin copia física hallada, no se escaneará
}

enum PhysicalDisposition {
  PENDING // Sin decisión
  DESTROY // Programado para destrucción
  DESTROYED // Destrucción confirmada
  ARCHIVE // Programado para almacenamiento físico
  ARCHIVED // Almacenamiento confirmado
}

// Archivos digitalizados pendientes de clasificación
model ScannedFile {
  id                    Int                 @id @default(autoincrement())
  createdAt             DateTime            @default(now())
  createdById           Int
  updatedAt             DateTime            @updatedAt
  updatedById           Int                 @default(1)
  projectId             Int
  documentTypeId        Int?
  documentClassId       Int?
  areaId                Int?
  code                  String              @db.VarChar(50) // Código único dentro del proyecto (ej: "SC-001")
  title                 String              @db.VarChar(500)
  description           String?             @db.Text
  originalReference     String?             @db.VarChar(255)
  physicalLocation      String?             @db.VarChar(500)
  fileKey               String?             @db.VarChar(500)
  fileName              String?             @db.VarChar(255)
  fileSize              Int?
  mimeType              String?             @db.VarChar(100)
  digitalDisposition    DigitalDisposition  @default(PENDING)
  physicalDisposition   PhysicalDisposition @default(PENDING)
  externalReference     String?             @db.VarChar(500)
  discardReason         String?             @db.Text
  classificationNotes   String?             @db.Text
  classifiedById        Int?
  classifiedAt          DateTime?
  physicalConfirmedById Int?
  physicalConfirmedAt   DateTime?
  terminatedAt          DateTime?

  documentType  DocumentType?  @relation(fields: [documentTypeId], references: [id])
  documentClass DocumentClass? @relation(fields: [documentClassId], references: [id])
  area          Area?          @relation(fields: [areaId], references: [id])

  @@unique([code, projectId])
  @@index([projectId])
  @@index([documentClassId])
  @@index([areaId])
  @@index([digitalDisposition])
  @@index([physicalDisposition])
  @@index([projectId, digitalDisposition])
  @@map("scanned_files")
}

// Áreas físicas o ubicaciones en planta
model Area {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  updatedById  Int       @default(1)
  terminatedAt DateTime?
  isSys        Boolean   @default(false)

  name        String // "01 - Urea", "02 - Amoníaco"
  code        String // "01", "02"
  projectId   Int // Proyecto al que pertenece
  description String?
  sortOrder   Int     @default(0)

  // Relaciones
  scannedFiles ScannedFile[]

  @@unique([code, projectId]) // Único dentro del mismo proyecto
  @@index([projectId])
  @@map("areas")
}

// Logs generales del sistema (operacionales)
model DocumentSysLog {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now())
  userId    Int // Referencia al User del sistema admin
  level     LogLevel
  module    SysLogModule?
  name      String?       @db.VarChar(200)
  message   String        @db.VarChar(2048)
  meta      String?       @db.Text

  @@index([module, userId, level, createdAt])
  @@map("document_sys_logs")
}

// Logs del Sistema Archivados
model DocumentSysLogArchive {
  id        Int           @id @default(autoincrement())
  createdAt DateTime
  userId    Int // Referencia al User del sistema admin
  level     LogLevel
  module    SysLogModule?
  name      String?       @db.VarChar(200)
  message   String        @db.VarChar(2048)
  meta      String?       @db.Text

  @@index([module, userId, level, createdAt])
  @@map("document_sys_logs_archive")
}
